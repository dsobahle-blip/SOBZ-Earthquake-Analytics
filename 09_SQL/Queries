-- 09_SQL/gold_queries.sql
-- Purpose: Analytical SQL queries on Gold layer tables
-- Use in: Fabric SQL Endpoint, Power BI DirectQuery, or Spark SQL

-- 1. Total Earthquakes by Magnitude Category
SELECT 
    magnitude_category,
    COUNT(*) AS quake_count,
    ROUND(AVG(magnitude), 2) AS avg_magnitude,
    ROUND(MAX(magnitude), 2) AS max_magnitude
FROM gold.magnitude_categories
GROUP BY magnitude_category
ORDER BY avg_magnitude DESC;

-- 2. Daily Earthquake Trends (Last 30 Days)
SELECT 
    date,
    daily_count,
    max_magnitude,
    ROUND(avg_magnitude, 2) AS avg_magnitude
FROM gold.daily_counts
ORDER BY date DESC
LIMIT 30;

-- 3. Top 10 Regional Hotspots
SELECT 
    region,
    quake_count,
    ROUND(max_magnitude, 2) AS max_magnitude,
    ROUND(avg_magnitude, 2) AS avg_magnitude,
    ROUND(avg_depth, 2) AS avg_depth
FROM gold.regional_hotspots
ORDER BY quake_count DESC
LIMIT 10;

-- 4. Depth Category Analysis
SELECT 
    depth_category,
    quake_count,
    ROUND(avg_magnitude, 2) AS avg_magnitude,
    ROUND(avg_depth, 2) AS avg_depth
FROM gold.depth_analysis
ORDER BY avg_depth DESC;

-- 5. Earthquakes Above Magnitude 6.0 (Major+ Events)
SELECT 
    event_id,
    magnitude,
    magnitude_category,
    location,
    event_time,
    depth
FROM gold.magnitude_categories
WHERE magnitude >= 6.0
ORDER BY magnitude DESC;

-- 6. Monthly Summary (Aggregated by Month)
SELECT 
    DATE_TRUNC('month', date) AS month,
    SUM(daily_count) AS monthly_total,
    ROUND(AVG(avg_magnitude), 2) AS monthly_avg_magnitude,
    MAX(max_magnitude) AS monthly_max_magnitude
FROM gold.daily_counts
GROUP BY DATE_TRUNC('month', date)
ORDER BY month DESC;
